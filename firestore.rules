rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /listings/{listingId} {
      // Published listings are public. Owners may read their own listings.
      allow read: if resource.data.status == 'PUBLISHED'
                  || (signedIn() && resource.data.sellerId == request.auth.uid)
                  || isAdmin();

      // User-created listings may start only in the pending state.
      allow create: if signedIn()
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.status == 'PAYMENT_PENDING'
                    && request.resource.data.keys().hasAll(['sellerId', 'status', 'title', 'createdAt']);

      // Admins may moderate status and rejection metadata; owners cannot change moderation fields.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'rejectionReason'])
                    && request.resource.data.status in ['PAYMENT_PENDING', 'PUBLISHED', 'REJECTED']
                    && (request.resource.data.status != 'REJECTED'
                        || (request.resource.data.rejectionReason is string
                            && request.resource.data.rejectionReason.size() > 0))
                    || (signedIn()
                        && resource.data.sellerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['title', 'description', 'priceDzd', 'category', 'updatedAt']));

      allow delete: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.isBlocked == false
                    && request.resource.data.keys().hasOnly(['name', 'phone', 'wilayaCode', 'isBlocked', 'updatedAt']);
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['isBlocked', 'updatedAt'])
                    && request.resource.data.isBlocked is bool
                    || (signedIn() && request.auth.uid == userId
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['name', 'phone', 'wilayaCode', 'updatedAt']));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.adminUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['action', 'targetId', 'adminUid', 'createdAt']);
      allow update, delete: if false;
    }

    // Keep other application collections inaccessible to the admin client unless explicit rules are added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
