rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function userPath(uid) { return signedIn() && request.auth.uid == uid; }
    function validImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /listings/{uid}/{listingId}/{fileName} {
      allow read: if isAdmin() || userPath(uid);
      allow write: if userPath(uid) && validImage();
      allow delete: if isAdmin() || userPath(uid);
    }

    match /payments/{uid}/{listingId}/{fileName} {
      allow read: if isAdmin() || userPath(uid);
      allow write: if userPath(uid) && validImage();
      allow delete: if isAdmin() || userPath(uid);
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
